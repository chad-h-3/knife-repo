---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/categories';
import { getCollection } from 'astro:content';
const all = await getCollection('listings');
const counts = Object.fromEntries(categories.map(c => [c.slug, all.filter(x => x.data.category === c.slug && x.data.status === 'Available').length]));
---
<BaseLayout title="Browse Categories">
  <section class="hero">
    <p class="eyebrow">Personal collection and available items</p>
    <h1>Explore the Collection</h1>
    <p class="muted">Browse knives and tools by category. Select a collection to see individual items, photos, condition, and asking prices.</p>
  </section>
  <section aria-labelledby="category-title">
    <h2 id="category-title">Shop by Category</h2>
    <div class="grid">
      {categories.map(c => <a class="card" href={`/knives/${c.slug}/`}>
        <div class="category-art"><img src={c.image} alt={c.imageAlt} loading="lazy" referrerpolicy="no-referrer" /></div>
        <div class="card-body"><h3>{c.title}</h3><p class="muted">{c.description}</p><span class="tag">{counts[c.slug]} available</span></div>
      </a>)}
    </div>
  </section>
  <section id="about" class="about"><h2>About the Collection</h2><p class="muted">Items are listed with condition and asking price. Selected listings may include a demonstration or restoration video. Contact information will be added before launch.</p></section>
</BaseLayout>
<style>
  .category-art{height:190px;overflow:hidden;background:#24343b}
  .category-art img{width:100%;height:100%;object-fit:cover;filter:brightness(.82) contrast(1.08);transition:transform .25s ease,filter .25s ease}
  .card:hover .category-art img{transform:scale(1.04);filter:brightness(.96) contrast(1.05)}
  .about{margin-top:65px}
</style>
